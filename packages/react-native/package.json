{
  "name": "@pollar/react-native",
  "version": "0.5.3",
  "description": "React Native components for Pollar authentication",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@pollar/core": "^0.11.3",
    "react": "^18 || ^19",
    "react-native": ">=0.72",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=13"
  },
  "dependencies": {
    "react-native-qrcode-svg": "^6.3.21"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@react-native/babel-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "@types/node": "^25.5.2",
    "@pollar/core": "^0.11.3",
    "@types/react": "~19.2.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3"
  }
}
