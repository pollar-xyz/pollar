{
  "name": "@pollar/react-native",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pollar-xyz/pollar.git",
    "directory": "packages/react-native"
  },
  "description": "React Native bindings for Pollar: authentication UI, transaction modals and hooks for Stellar mobile applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@pollar/core": "^0.11.3",
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@pollar/core": "^0.11.3",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-native": "^0.72.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
